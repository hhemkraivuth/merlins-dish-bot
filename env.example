# Copy this file to ".env" for local testing, OR enter these same names
# as "Variables" in Railway (see README.md, Step 6). Never commit the
# real .env file or share these values with anyone.

# From LINE Developers Console > your Messaging API channel
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# From Thunder Solution developer dashboard (developer.thunder.in.th)
THUNDER_API_KEY=

# The LINE group or account that should receive each finished order.
# Leave blank at first -- README Step 8 shows you how to find this value.
LINE_INTERNAL_TARGET_ID=

# Your own personal LINE user ID -- lets you text the bot admin commands
# like "soldout rws_r". Found the same way as LINE_INTERNAL_TARGET_ID.
ADMIN_USER_ID=

# Your shop's coordinates, used to calculate delivery distance for the
# free-under-2km rule. Get these from Google Maps: right-click your
# location on the map > click the coordinates that appear to copy them.
SHOP_LAT=
SHOP_LNG=

# OPTIONAL. Only needed if you want orders auto-logged to your Google Sheet.
# Leave both blank to skip Sheet logging -- the bot works fine without it.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=1uyJUnNE9K6No8Vxe0tsTjN6pFguRqc0BI5yHU4oHAA8
