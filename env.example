# Copy this file to ".env" for local testing, OR enter these same names
# as "Variables" in Railway (see README.md, Step 6). Never commit the
# real .env file or share these values with anyone.

# From LINE Developers Console > your Messaging API channel
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# From Thunder Solution developer dashboard (developer.thunder.in.th)
THUNDER_API_KEY=

# Shown to customers when they pick "Bank Transfer" at checkout, e.g.
# "KBank 123-4-56789-0 (Merlin's Dish)"
BUSINESS_PAYMENT_INFO=

# A direct https:// link to your bank/PromptPay QR code image, shown when
# a customer picks "QR Code" at checkout instead. Upload the QR image into
# the same "images" folder as your dish photos (see menu.js) and use the
# same raw.githubusercontent.com link format. Leave blank to only offer
# bank details -- the QR button will fall back to bank details automatically.
QR_IMAGE_URL=

# From your Cloudinary account (cloudinary.com) -- Dashboard page shows all
# three of these. Used to permanently save every payment slip photo (for
# your own accounting), separate from the QR image link above, which is
# just a static hosted image you uploaded once.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Your LIFF app's ID, from LINE Developers Console (LIFF tab). Used by the
# "menu" text trigger to send an "Order Now" button that opens the app.
# You'll also paste this same value into public/app.js separately (that
# file can't read this .env, being a plain static file in the browser).
LIFF_ID=

# The LINE group or account that should receive each finished order.
# Leave blank at first -- README Step 8 shows you how to find this value.
LINE_INTERNAL_TARGET_ID=

# Your own personal LINE user ID -- lets you text the bot admin commands
# like "soldout rws_r". Found the same way as LINE_INTERNAL_TARGET_ID.
ADMIN_USER_ID=

# Your shop's coordinates, used to calculate delivery distance for the
# free-under-2km rule. Get these from Google Maps: right-click your
# location on the map > click the coordinates that appear to copy them.
SHOP_LAT=
SHOP_LNG=

# OPTIONAL. Only needed if you want orders auto-logged to your Google Sheet.
# Leave both blank to skip Sheet logging -- the bot works fine without it.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=1uyJUnNE9K6No8Vxe0tsTjN6pFguRqc0BI5yHU4oHAA8
